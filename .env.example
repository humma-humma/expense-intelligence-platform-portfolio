EXPENSE_ENVIRONMENT=development
EXPENSE_LOG_LEVEL=INFO
EXPENSE_MONTHLY_BUDGET_TARGET_EUR=15
EXPENSE_MONTHLY_BUDGET_ALERT_EUR=25
EXPENSE_DATABASE_URL=postgresql+psycopg://expense:expense@postgres:5432/expense
EXPENSE_REDIS_URL=redis://redis:6379/0
EXPENSE_S3_ENDPOINT_URL=http://minio:9000
EXPENSE_S3_ACCESS_KEY=expense-local
EXPENSE_S3_SECRET_KEY=expense-local-secret
EXPENSE_S3_BUCKET=receipts
EXPENSE_S3_REGION=eu-central-1
EXPENSE_S3_SERVER_SIDE_ENCRYPTION=false
EXPENSE_MAX_UPLOAD_BYTES=10485760
EXPENSE_OCR_PROVIDER=fake
EXPENSE_OCR_REVIEW_THRESHOLD=80
